---
const { project } = Astro.props;
---
<article class="project-card reveal">
  <div class="project-top"><span>作品</span><span>↗</span></div>
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
  <a href={project.url} target="_blank" rel="noreferrer">前往作品網站 <span>→</span></a>
</article>
